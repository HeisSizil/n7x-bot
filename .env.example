# Copy this file to ".env" and fill in your own values.
# NEVER share your .env file or commit it to GitHub.

# --- Required ---
# Your bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# --- Optional but recommended while testing ---
# Your test server's ID. Slash commands appear instantly in this server.
# (Without it, commands sync globally, which can take up to an hour.)
# Right-click your server icon -> "Copy Server ID" (needs Developer Mode on).
GUILD_ID=

# --- Channels ---
# Right-click a channel -> "Copy Channel ID" (needs Developer Mode on).
# Mod-log: a private channel only mods can see. The bot posts moderation notes here.
MOD_LOG_CHANNEL_ID=
# Optional. A private mods-only channel where the mod assistant shows private results
# (warnings lists, summaries) instead of sending them by DM. The assistant only
# answers when a mod @mentions the bot or replies to one of the bot's messages.
MOD_ASSISTANT_CHANNEL_ID=

# --- Crypto (Stage 4) ---
# Optional. /price works without it. A free "demo" key from
# https://www.coingecko.com/en/api raises the rate limit.
COINGECKO_API_KEY=

# --- AI for /ask (Stage 5) ---
# All three are free. The bot tries Gemini first, then Groq, then OpenRouter.
# You need at least ONE key; any provider without a key is skipped.
#   Gemini key:     https://aistudio.google.com/apikey
#   Groq key:       https://console.groq.com/keys
#   OpenRouter key: https://openrouter.ai/keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Model names (leave empty to use the defaults shown).
# If a provider retires a model, put the new name here - no code changes needed.
# OpenRouter: only models ending in ":free" are allowed (so you never get billed).
#   Browse free ones at https://openrouter.ai/models?max_price=0
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
